# Copier ce fichier en .env.local (ignoré par git). Ne jamais committer de
# secret. Liste complète prévue : CAHIER_DES_CHARGES.md, annexe A.

# Origine publique du site (sans chemin), utilisée pour les liens absolus
# (emails, retours de paiement, référencement).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé privée, disponible uniquement côté serveur. Ne jamais la préfixer par
# NEXT_PUBLIC_ et ne jamais l'utiliser dans un Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Secret dédié au hachage des identifiants de limitation de débit (au moins
# 32 caractères aléatoires). À défaut, la clé service Supabase est utilisée.
RATE_LIMIT_SECRET=

# Emails (rubrique Emails de l'admin). Sans fournisseur, les emails sont
# préparés dans l'admin et envoyés depuis votre messagerie en un clic.
# Fournisseur : brevo ou resend (laisser vide pour aucun).
EMAIL_PROVIDER=
# Clé d'API du fournisseur (secret, côté serveur uniquement).
EMAIL_API_KEY=
# Expéditeur, sur un domaine authentifié chez le fournisseur (SPF, DKIM) :
# « Ruchers de Normandie <contact@votre-domaine.fr> ».
EMAIL_FROM=
# Adresse qui reçoit les réponses des clients (sinon : l'expéditeur).
EMAIL_REPLY_TO=
# Adresse qui reçoit l'alerte « nouvelle demande de commande ».
ADMIN_NOTIFICATION_EMAIL=

# Tâche quotidienne : demandes d'avis et purge des données anciennes
# (vercel.json, /api/cron/quotidien).
# Secret aléatoire d'au moins 16 caractères ; Vercel l'envoie dans
# l'en-tête Authorization. Sans lui, utilisez « Envoyer maintenant » dans
# la rubrique Avis de l'admin.
CRON_SECRET=
