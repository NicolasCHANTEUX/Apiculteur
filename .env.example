# Supabase — créer un projet sur https://supabase.com puis renseigner ces
# valeurs depuis Project Settings > API. Copier ce fichier en .env.local
# (ignoré par git) pour le développement local / Codespace.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle privee, disponible uniquement cote serveur. Ne jamais la prefixer par
# NEXT_PUBLIC_ et ne jamais l'utiliser dans un Client Component.
SUPABASE_SERVICE_ROLE_KEY=
